---
import MetricsShell from '../../components/MetricsShell.astro';
import { guardMetrics } from '../../lib/metrics-guard';
import { listUsers, removeUser, createUser, sendPasswordReset, signUpIsOpen } from '../../lib/metrics-access';

export const prerender = false;

const { identity, response, env } = await guardMetrics(Astro.request, Astro.url);
if (!identity) return response!;

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

let toast: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.has('remove')) {
    toast = (await removeUser(String(form.get('remove')), identity.email, env.DATABASE_URL)).message;
  } else if (form.has('reset')) {
    toast = (await sendPasswordReset(String(form.get('reset')), env.NEON_AUTH_URL)).message;
  } else if (form.has('new-email')) {
    toast = (await createUser({
      email: String(form.get('new-email')),
      name: String(form.get('new-name') ?? ''),
    }, env.NEON_AUTH_URL)).message;
  }
}

const users = await listUsers(env.DATABASE_URL);
const signupOpen = await signUpIsOpen(env.DATABASE_URL);

const fmt = (iso: string) =>
  new Intl.DateTimeFormat('es-ES', {
    day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Europe/Madrid',
  }).format(new Date(iso));
---

<MetricsShell title="Usuarios" email={identity.email} active="usuarios" toast={toast}>
  <h1>Usuarios</h1>
  <p class="lede">
    Cualquiera con cuenta puede abrir este panel — no hay una lista de permisos
    aparte. Créalas aquí o en la consola de Neon Auth; es la misma lista.
  </p>

  {signupOpen && (
    <div class="note warn">
      <strong>El registro público está abierto.</strong> Cualquiera puede crearse
      una cuenta y, con ella, entrar aquí. Desactiva el registro
      (<code>disableSignUp</code>) en la consola de Neon Auth.
    </div>
  )}

  <div style="display:flex;justify-content:flex-end;margin-bottom:14px;">
    <button class="btn primary" type="button" id="open-create">Crear cuenta</button>
  </div>

  <div class="tablewrap">
    {users.length === 0 ? (
      <p class="empty">No hay cuentas todavía.</p>
    ) : (
      <table>
        <thead><tr><th>Nombre</th><th>Correo</th><th>Desde</th><th></th></tr></thead>
        <tbody>
          {users.map((u) => (
            <tr>
              <td class="who-cell">
                {u.name ?? '—'}
                {u.banned && <span class="chip" style="margin-left:8px">bloqueada</span>}
              </td>
              <td>{u.email}</td>
              <td class="when">{u.createdAt ? fmt(u.createdAt) : '—'}</td>
              <td>
                <div style="display:flex;gap:6px;justify-content:flex-end;">
                  <button class="btn js-reset" type="button" data-email={u.email}>Contraseña</button>
                  {u.email.toLowerCase() === identity.email.toLowerCase() ? (
                    <span class="chip">tú</span>
                  ) : (
                    <button class="btn danger js-remove" type="button" data-email={u.email}>Eliminar</button>
                  )}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>

  <dialog id="dlg-create">
    <h2>Crear una cuenta</h2>
    <p class="sub">
      Se crea la cuenta y se le envía un correo para que elija su contraseña.
      Nadie más llega a verla.
    </p>
    <form method="POST">
      <label>Nombre<input name="new-name" type="text" placeholder="Nombre y apellido" required /></label>
      <label>Correo<input name="new-email" type="email" placeholder="nombre@orbitaleap.com" required /></label>
      <div class="dialog-actions">
        <button class="btn" type="button" data-close>Cancelar</button>
        <button class="btn primary" type="submit">Crear y enviar</button>
      </div>
    </form>
  </dialog>

  <dialog id="dlg-remove">
    <h2>Eliminar cuenta</h2>
    <p class="sub">
      <strong id="rm-email"></strong> perderá el acceso al panel de inmediato.
      No se puede deshacer.
    </p>
    <form method="POST">
      <input type="hidden" name="remove" id="rm-input" />
      <div class="dialog-actions">
        <button class="btn" type="button" data-close>Cancelar</button>
        <button class="btn danger" type="submit">Eliminar</button>
      </div>
    </form>
  </dialog>

  <dialog id="dlg-reset">
    <h2>Enviar correo de contraseña</h2>
    <p class="sub">
      Se enviará a <strong id="rs-email"></strong> un enlace para elegir una
      contraseña nueva.
    </p>
    <form method="POST">
      <input type="hidden" name="reset" id="rs-input" />
      <div class="dialog-actions">
        <button class="btn" type="button" data-close>Cancelar</button>
        <button class="btn primary" type="submit">Enviar</button>
      </div>
    </form>
  </dialog>

  <script>
    // Native <dialog>: Escape closes it, focus is trapped, and the backdrop
    // needs no overlay element. Every destructive or email-sending action goes
    // through one — a row button no longer does anything on its own.
    const byId = (id: string) => document.getElementById(id) as HTMLDialogElement;

    document.getElementById('open-create')?.addEventListener('click', () => byId('dlg-create').showModal());

    document.querySelectorAll<HTMLElement>('.js-remove').forEach((b) =>
      b.addEventListener('click', () => {
        const email = b.dataset.email ?? '';
        (document.getElementById('rm-email') as HTMLElement).textContent = email;
        (document.getElementById('rm-input') as HTMLInputElement).value = email;
        byId('dlg-remove').showModal();
      }));

    document.querySelectorAll<HTMLElement>('.js-reset').forEach((b) =>
      b.addEventListener('click', () => {
        const email = b.dataset.email ?? '';
        (document.getElementById('rs-email') as HTMLElement).textContent = email;
        (document.getElementById('rs-input') as HTMLInputElement).value = email;
        byId('dlg-reset').showModal();
      }));

    document.querySelectorAll<HTMLElement>('[data-close]').forEach((b) =>
      b.addEventListener('click', () => b.closest('dialog')?.close()));
  </script>
</MetricsShell>
