---
import { Icon } from 'astro-icon/components';
import Layout from '../../layouts/Layout.astro';

// Dedicated thank-you URL (studio.orbitaleap.com/launch/deployed) for the
// /launch ads landing page. Both contact forms on /launch redirect here on a
// successful submission — this is the page Google Ads' "Carga de la página"
// conversion action watches for, since the forms themselves submit via
// fetch() and never navigate on their own.
// noindex + excluded from the sitemap (astro.config.mjs filters anything
// containing "/launch") for the same reason the parent landing page is.
---

<Layout
  title="Gracias | Orbital Leap Studio"
  description="Hemos recibido tu solicitud. Te contactamos en menos de 24 horas."
  noindex

  {/* NOT the shared tag. The conversion action for this page is URL-based, so
      it counts any page view here — loading the tag unconditionally would give
      a conversion to every crawler, refresh and shared link. The gated loader
      at the bottom of this page is the only one that may run. */}
  ads={false}

  {/* No cookie notice, same as /launch — this is the second half of the same
      paid funnel and inherited the layout default only because it never said
      otherwise. The consent that gates the tag below is the privacy checkbox
      the visitor ticked on /launch: without it the form does not submit, and
      without a submit this page never loads the tag at all. */}
  banner={false}>
  <main class="min-h-screen flex items-center justify-center bg-[#0A0A0A] text-white px-6 py-24">
    <div class="max-w-lg text-center">
      <span class="font-sans text-xs font-semibold uppercase tracking-widest text-white/50 block mb-5">
        Orbital Leap Studio
      </span>
      <h1 class="font-sans text-4xl sm:text-5xl font-bold tracking-tight leading-tight mb-6">
        Gracias. Ya tenemos tu solicitud.
      </h1>
      <p class="font-sans text-white/65 text-lg font-light leading-relaxed mb-10">
        Hemos recibido tu consulta y te responderemos en menos de 24 horas con un presupuesto concreto.
      </p>
      <a
        href="/"
        class="inline-flex items-center justify-center gap-2 border border-white/25 rounded-lg px-7 py-3.5 font-sans text-xs font-semibold uppercase tracking-wider text-white hover:border-white/50 hover:bg-white/5 transition-colors"
      >
        Volver al inicio
        <Icon name="ph:arrow-right-bold" class="w-3.5 h-3.5" />
      </a>
    </div>
  </main>
  <!--
    The conversion tag, loaded from here rather than declared in Layout.
    
    This URL is a plain page: anything that fetches it fires the Google Ads
    "Carga de la página" conversion — a crawler, a shared link, a bookmark,
    someone refreshing. noindex keeps it out of the index but does not stop a
    fetch, and every one of those would have been counted as a lead.

    So the tag is injected only when this page was reached by actually
    submitting the form. /launch sets a one-shot flag immediately before the
    redirect; this reads it and clears it, so a refresh does not count twice
    and a direct visit counts not at all. sessionStorage rather than a cookie
    because it dies with the tab and writes nothing persistent.

    It also means the advertising cookie is set only after the privacy
    checkbox was ticked and sent — the tag never loads for anyone else.
  -->
  <script is:inline define:vars={{ adsId: 'AW-18312929105' }}>
    (function () {
      var KEY = 'ol_launch_conversion';
      if (sessionStorage.getItem(KEY) !== '1') return;
      sessionStorage.removeItem(KEY);

      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + adsId;
      document.head.appendChild(s);

      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = gtag;

      // Same consent posture as the shared tag in Layout, which does not run
      // on this page. Declaring it here matters for the rejection below: a
      // 'consent update' with nothing defaulted first is not applied.
      gtag('consent', 'default', {
        ad_storage: 'granted',
        ad_user_data: 'granted',
        ad_personalization: 'granted',
        analytics_storage: 'granted'
      });

      // A visitor who declined in the cookie notice stays declined here too.
      // This page carries no notice of its own, so without the check a
      // rejection recorded anywhere else on the site was ignored at exactly
      // the point an advertising cookie would be written.
      if (localStorage.getItem('ol_cookie_consent') === 'rejected') {
        gtag('consent', 'update', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied'
        });
      }

      gtag('js', new Date());
      gtag('config', adsId);
    })();
  </script>
</Layout>
