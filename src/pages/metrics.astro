---
import MetricsShell from '../components/MetricsShell.astro';
import { guardMetrics } from '../lib/metrics-guard';
import { readMetrics } from '../lib/leads-store';

// Server-rendered, always. A prerendered /metrics would be a static file in
// dist/, served by the assets layer before any Worker code ran — to anyone who
// asked for it.
export const prerender = false;

const { identity, response, env } = await guardMetrics(Astro.request, Astro.url);
if (!identity) return response!;

// Never cached: per-session, and it lists personal data, so an intermediary
// holding a copy would be a leak.
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

// No POST handler any more. This page only reads.
//
// It used to offer a per-row delete, for an erasure request. That put an
// irreversible action one misclick away from a real customer's details, on a
// list you scroll past every day, to serve something that happens rarely and
// has to be done carefully when it does. An erasure request is answered in the
// database, deliberately, by someone who meant to.
const toast: string | null = null;

// Which site is being looked at, from the query string rather than a cookie or
// a POST: it makes the filtered view a real URL that can be bookmarked and
// reloaded, and it keeps the page a GET, which is what a read-only page should
// be. An unknown value simply matches nothing, and the picker offers the way
// back — the parameter reaches SQL as a placeholder, never as query text.
const site = Astro.url.searchParams.get('site') ?? '';

const m = await readMetrics(env.DATABASE_URL, site);

const sitePath = (url: string | null) =>
  url ? url.replace(/^https?:\/\/[^/]*/, '') || '/' : '—';

const fmt = (iso: string) =>
  new Intl.DateTimeFormat('es-ES', {
    day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit',
    timeZone: 'Europe/Madrid',
  }).format(new Date(iso));

const peak = m ? Math.max(1, ...m.daily.map((d) => d.n)) : 1;
const pct = (n: number, of: number) => (of ? Math.round((n / of) * 100) : 0);
---

<MetricsShell title="Panel" email={identity.email} active="dashboard" toast={toast}>
  <h1>Panel</h1>
  <p class="lede">
    Cada lead que entra por los formularios, con el canal por el que llegó.
  </p>

  {m === null && (
    <div class="note">
      <strong>Sin conexión a la base de datos.</strong> Falta el secreto
      <code>DATABASE_URL</code> en el Worker. Los leads siguen llegando por
      correo con normalidad; solo no quedan registrados aquí.
    </div>
  )}

  {m && m.sites.length > 0 && (
    <nav class="sites" aria-label="Filtrar por sitio">
      <a href="/metrics" class={site === '' ? 'on' : ''}>Todos</a>
      {m.sites.map((h) => (
        <a href={`/metrics?site=${encodeURIComponent(h)}`} class={site === h ? 'on' : ''}>{h}</a>
      ))}
    </nav>
  )}

  {m && (
    <>
      <div class="kpis">
        <div class="kpi"><b>{m.total}</b><span>Total</span></div>
        <div class="kpi"><b>{m.last30}</b><span>Últimos 30 días</span></div>
        <div class="kpi"><b>{m.last7}</b><span>Últimos 7 días</span></div>
        <div class="kpi">
          <b>{pct(m.byChannel.find((c) => c.label === 'Google Ads')?.n ?? 0, m.total)}%</b>
          <span>Desde Google Ads</span>
        </div>
      </div>

      <div class="card" style="margin-bottom:12px;">
        <h2>Leads por día · últimos 30</h2>
        {m.daily.length === 0 ? (
          <p class="empty">Sin datos todavía.</p>
        ) : (
          <>
            <div class="spark">
              {m.daily.map((d) => (
                <div style={`height:${Math.round((d.n / peak) * 100)}%`} title={`${d.day}: ${d.n}`}></div>
              ))}
            </div>
            <div class="spark-x">
              <span>{m.daily[0]?.day}</span>
              <span>{m.daily[m.daily.length - 1]?.day}</span>
            </div>
          </>
        )}
      </div>

      <div class="grid">
        {[
          { title: 'Canal', data: m.byChannel },
          { title: 'Formulario', data: m.byForm },
          // Only worth a card when more than one site is in view; filtered to
          // one host it would be a single bar reading 100%.
          ...(site === '' ? [{ title: 'Sitio', data: m.bySite }] : []),
          { title: 'Página de envío', data: m.byPage },
          { title: 'Página de entrada', data: m.byLanding },
        ].map((block) => (
          <div class="card">
            <h2>{block.title}</h2>
            {block.data.length === 0 ? (
              <p class="empty">Sin datos.</p>
            ) : (
              <div class="rows">
                {block.data.map((r) => (
                  <div class="row">
                    <span class="lbl">{r.label}</span>
                    <span class="n">{r.n}</span>
                    <span class="meter"><i style={`width:${pct(r.n, m.total)}%`}></i></span>
                  </div>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>

      <div class="tablewrap">
        {m.recent.length === 0 ? (
          <p class="empty">Todavía no ha entrado ningún lead.</p>
        ) : (
          <table style="min-width:900px">
            <thead>
              <tr>
                <th>Cuándo</th><th>Quién</th><th>Contacto</th><th>Canal</th>
                <th>Formulario</th><th>Enviado desde</th><th>Entró por</th><th>Mensaje</th>
              </tr>
            </thead>
            <tbody>
              {m.recent.map((l) => (
                <tr>
                  <td class="when">{fmt(l.created_at)}</td>
                  <td class="who-cell">
                    {l.name}
                    {l.company && <div style="color:var(--dim);font-weight:400;">{l.company}</div>}
                    {l.city && <div style="color:var(--dim);font-weight:400;font-size:0.9em;">{[l.city, l.country].filter(Boolean).join(', ')}</div>}
                  </td>
                  <td>
                    <a href={`mailto:${l.email}`}>{l.email}</a>
                    {l.phone && <div><a href={`tel:${l.phone}`}>{l.phone}</a></div>}
                  </td>
                  <td>
                    <span class="chip">{l.channel ?? 'Sin registrar'}</span>
                    {l.detail && <div style="font-size:0.75rem;margin-top:5px;">{l.detail}</div>}
                  </td>
                  <td>{l.form}</td>
                  <td class="site-cell">
                    {sitePath(l.site)}
                    {/* The host only when every site is in view — filtered to
                        one, repeating it on all fifty rows says nothing. */}
                    {site === '' && l.site && (
                      <div style="color:var(--dim);font-size:0.8em;">{l.site.replace(/^https?:\/\//, '').split('/')[0]}</div>
                    )}
                  </td>
                  <td>{l.landing ?? '—'}</td>
                  <td><div class="msg">{l.message ?? ''}</div></td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </>
  )}

  <style>
    /* Links, not a <select> — the filtered view is a real URL, and it works
       with scripting off, which a JS-driven picker would not. */
    .sites { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
    .sites a { border: 1px solid var(--line); background: var(--panel); border-radius: 999px; padding: 6px 14px; font-size: 0.82rem; color: var(--mid); text-decoration: none; }
    .sites a:hover { color: var(--ink); }
    .sites a.on { background: var(--ink); border-color: var(--ink); color: var(--panel); font-weight: 600; }
    .site-cell { font-variant-numeric: tabular-nums; max-width: 220px; overflow: hidden; text-overflow: ellipsis; }
    .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 12px; margin-bottom: 32px; }
    .kpi { border: 1px solid var(--line); background: var(--panel); border-radius: 12px; padding: 18px 20px; }
    .kpi b { display: block; font-size: clamp(1.8rem, 5vw, 2.6rem); font-weight: 700; letter-spacing: -0.03em; font-variant-numeric: tabular-nums; line-height: 1.05; }
    .kpi span { font-size: 0.72rem; letter-spacing: 0.13em; text-transform: uppercase; color: var(--dim); }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 12px; margin-bottom: 32px; }
    .rows { display: flex; flex-direction: column; gap: 10px; }
    .row { display: grid; grid-template-columns: 1fr auto; gap: 10px; align-items: center; font-size: 0.9rem; }
    .row .lbl { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--mid); }
    .row .n { font-variant-numeric: tabular-nums; color: var(--ink); font-weight: 600; }
    .meter { grid-column: 1 / -1; height: 4px; border-radius: 2px; background: rgba(255,255,255,0.08); overflow: hidden; }
    .meter i { display: block; height: 100%; background: var(--bar); }
    .spark { display: flex; align-items: flex-end; gap: 3px; height: 110px; }
    .spark div { flex: 1 1 0; background: var(--bar); border-radius: 2px 2px 0 0; min-height: 2px; opacity: 0.9; }
    .spark-x { display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--dim); margin-top: 8px; font-variant-numeric: tabular-nums; }
    .msg { max-width: 320px; white-space: pre-wrap; font-size: 0.8rem; color: var(--dim); max-height: 5.4em; overflow: hidden; }
  </style>

  <script>
    document.querySelectorAll<HTMLElement>('[data-close]').forEach((b) =>
      b.addEventListener('click', () => b.closest('dialog')?.close()));
  </script>
</MetricsShell>
