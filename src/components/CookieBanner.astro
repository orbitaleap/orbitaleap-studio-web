---
// CookieBanner.astro — RGPD / LSSI-CE cookie consent.
//
// Two layers: a compact bar, and a preferences panel behind "Personalizar".
//
// The bar used to offer only "Solo esenciales" and "Aceptar", which under
// Consent Mode advanced is not enough to express the decision — advanced
// splits consent into four signals, and a single Accept cannot say "measure
// me but do not use my data for ad personalisation". The panel exposes the
// two categories those four signals collapse into.
//
// Rejecting is exactly as easy as accepting: both are one click, side by
// side, styled with equal weight. A reject path that takes more steps than
// the accept path is the specific pattern the AEPD calls out.
//
// The copy follows what the page actually loads, via `advertising` — Layout
// passes its own `ads` value, so the wording and the tag cannot drift apart.

interface Props {
  /** This page loads the advertising tag. Drives the wording only; the
      decision itself is site-wide and applies wherever the tag runs. */
  advertising?: boolean;
}

const { advertising = false } = Astro.props;
---

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Preferencias de cookies" aria-modal="false">
  <!-- Compact bar -->
  <div class="cookie-inner" id="cookie-compact">
    <div class="cookie-text">
      <p class="cookie-title">Usamos cookies</p>
      <p class="cookie-desc">
        {advertising
          ? 'Usamos cookies propias necesarias para el funcionamiento del sitio y, con tu permiso, cookies de medición y publicidad de proveedores externos.'
          : 'Usamos cookies propias necesarias para el funcionamiento de este sitio.'}{' '}
        <a href="https://orbitaleap.com/cookies/" class="cookie-link">Política de cookies</a><span class="cookie-sep" aria-hidden="true">·</span><a href="https://orbitaleap.com/privacidad/" class="cookie-link">Privacidad</a>
      </p>
    </div>
    <div class="cookie-actions">
      <button id="cookie-customise" type="button" class="cookie-btn-ghost">Personalizar</button>
      <button id="cookie-reject" type="button" class="cookie-btn-outline">Solo esenciales</button>
      <button id="cookie-accept" type="button" class="cookie-btn-solid">Aceptar todo</button>
    </div>
  </div>

  <!-- Preferences panel -->
  <div class="cookie-prefs" id="cookie-prefs" hidden>
    <p class="cookie-prefs-title">Elige qué permites</p>

    <div class="cookie-cat">
      <div class="cookie-cat-text">
        <p class="cookie-cat-name">Necesarias <span class="cookie-cat-qual">(Imprescindibles)</span></p>
        <p class="cookie-cat-desc">
          Son los cimientos: sin ellas la web no puede funcionar.
        </p>
      </div>
      <!-- Disabled rather than absent: people look for the category they were
           told about, and a locked switch explains itself. -->
      <!-- The note goes BEFORE the switch so all three switches sit flush to
           the same right edge. After it, this one was pushed left by the width
           of the word and broke the column. -->
      <label class="cookie-switch is-locked">
        <span class="cookie-switch-note">Siempre</span>
        <input type="checkbox" checked disabled aria-label="Estrictamente necesarias, siempre activas" />
        <span class="cookie-switch-ui"></span>
      </label>
    </div>

    <div class="cookie-cat">
      <div class="cookie-cat-text">
        <p class="cookie-cat-name">Marketing <span class="cookie-cat-qual">(A tu medida)</span></p>
        <p class="cookie-cat-desc">
          Sirven para que, cuando nos encuentres fuera de esta web, lo que veas de
          nosotros sea justo lo que más te interesa. Pueden intervenir proveedores
          externos de publicidad.
        </p>
      </div>
      <label class="cookie-switch">
        <input type="checkbox" id="cookie-cat-ads" aria-label="Permitir cookies de publicidad" />
        <span class="cookie-switch-ui"></span>
      </label>
    </div>

    <div class="cookie-cat">
      <div class="cookie-cat-text">
        <p class="cookie-cat-name">Analíticas <span class="cookie-cat-qual">(Para mejorar)</span></p>
        <p class="cookie-cat-desc">
          Nos permiten detectar errores y páginas lentas, para que la web te funcione
          mejor cada vez. Siempre de forma agregada, nunca para identificarte.
        </p>
      </div>
      <label class="cookie-switch">
        <input type="checkbox" id="cookie-cat-analytics" aria-label="Permitir cookies de analítica" />
        <span class="cookie-switch-ui"></span>
      </label>
    </div>

    <div class="cookie-prefs-actions">
      <button id="cookie-save" type="button" class="cookie-btn-solid">Guardar preferencias</button>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    width: calc(100% - 2.5rem);
    max-width: 64rem;
    background: #fff;
    /* No shadow. A large blur with a small offset rings the card instead of
       sitting under it, which over any photographic background reads as a
       smudged border. The hairline is the edge. */
    border: 1px solid rgba(0,0,0,0.1);
    border-radius: 16px;
    padding: 1.5rem 1.75rem;
    display: none; /* shown by JS only if no consent stored */
    animation: slideUp 0.3s ease;
    max-height: calc(100vh - 2.5rem);
    overflow-y: auto;
  }
  .cookie-banner.visible { display: block; }

  @keyframes slideUp {
    from { opacity: 0; transform: translateX(-50%) translateY(12px); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cookie-banner { animation: none; }
  }

  .cookie-inner { display: flex; flex-direction: column; gap: 1rem; }

  /* Three buttons are wide. Below this the row would squeeze the sentence
     into a narrow column with dead space beside it, so it stacks instead.
     flex-wrap lets the buttons drop to their own line rather than steal
     width from the text at in-between sizes. */
  @media (min-width: 900px) {
    .cookie-inner { flex-direction: row; align-items: center; justify-content: space-between; gap: 2.5rem; flex-wrap: wrap; }
  }

  .cookie-text { flex: 1 1 26rem; min-width: 20rem; }

  .cookie-title {
    font-family: inherit; font-size: 0.875rem; font-weight: 700;
    color: #000; margin: 0 0 0.25rem; letter-spacing: -0.01em;
  }

  .cookie-desc {
    font-family: inherit; font-size: 0.8125rem; color: rgba(0,0,0,0.55);
    font-weight: 400; line-height: 1.55; margin: 0;
  }

  .cookie-link { color: #000; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .cookie-link:hover { text-decoration: none; }

  /* The separator carries its own margins rather than sitting between two text
     nodes: the template collapses the whitespace around it, so it rendered as
     "Política de cookies ·Privacidad" — glued on one side and not the other. */
  .cookie-sep { margin: 0 0.5rem; color: rgba(0,0,0,0.35); font-weight: 400; text-decoration: none; }

  .cookie-actions { display: flex; gap: 0.5rem; flex-shrink: 0; flex-wrap: wrap; align-items: center; }

  .cookie-btn-outline,
  .cookie-btn-solid,
  .cookie-btn-ghost {
    font-family: inherit; font-size: 0.75rem; font-weight: 600;
    letter-spacing: 0.04em; text-transform: uppercase;
    padding: 0.625rem 1.125rem; border-radius: 9999px;
    cursor: pointer; white-space: nowrap;
    transition: border-color 0.18s, background 0.18s;
  }

  /* Reject and accept carry identical visual weight and sit side by side —
     nudging people toward Accept with a louder button is the dark pattern
     this control exists to avoid. */
  .cookie-btn-outline { border: 1.5px solid rgba(0,0,0,0.2); background: transparent; color: #000; }
  .cookie-btn-outline:hover { border-color: rgba(0,0,0,0.45); background: rgba(0,0,0,0.03); }

  .cookie-btn-solid { border: 1.5px solid #000; background: #000; color: #fff; }
  .cookie-btn-solid:hover { background: #222; border-color: #222; }

  .cookie-btn-ghost { border: 1.5px solid transparent; background: transparent; color: rgba(0,0,0,0.6); text-decoration: underline; text-underline-offset: 3px; }
  .cookie-btn-ghost:hover { color: #000; }

  .cookie-btn-outline:focus-visible,
  .cookie-btn-solid:focus-visible,
  .cookie-btn-ghost:focus-visible { outline: 2px solid #000; outline-offset: 2px; }

  /* ── Preferences panel ── */
  .cookie-prefs { margin-top: 1.25rem; border-top: 1px solid rgba(0,0,0,0.1); padding-top: 1rem; }

  .cookie-prefs-title {
    font-family: inherit; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: rgba(0,0,0,0.45); margin: 0 0 0.75rem;
  }

  .cookie-cat {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 1.5rem;
    padding: 0.75rem 0; border-bottom: 1px solid rgba(0,0,0,0.06);
  }

  .cookie-cat-name { font-family: inherit; font-size: 0.8125rem; font-weight: 700; color: #000; margin: 0 0 0.15rem; }
  /* The qualifier says what the category is FOR before the sentence explains
     it. Lighter so the category name still leads. */
  .cookie-cat-qual { font-weight: 400; color: rgba(0,0,0,0.45); }
  .cookie-cat-desc { font-family: inherit; font-size: 0.75rem; line-height: 1.5; color: rgba(0,0,0,0.55); margin: 0; }

  .cookie-switch { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; cursor: pointer; }
  .cookie-switch.is-locked { cursor: default; }
  .cookie-switch input { position: absolute; opacity: 0; width: 0; height: 0; }

  .cookie-switch-ui {
    width: 40px; height: 23px; border-radius: 9999px;
    background: rgba(0,0,0,0.18); position: relative; transition: background 0.18s;
  }
  .cookie-switch-ui::after {
    content: ''; position: absolute; top: 3px; left: 3px;
    width: 17px; height: 17px; border-radius: 50%; background: #fff;
    transition: transform 0.18s;
  }
  .cookie-switch input:checked + .cookie-switch-ui { background: #000; }
  .cookie-switch input:checked + .cookie-switch-ui::after { transform: translateX(17px); }
  .cookie-switch input:disabled + .cookie-switch-ui { background: rgba(0,0,0,0.35); }
  .cookie-switch input:focus-visible + .cookie-switch-ui { outline: 2px solid #000; outline-offset: 2px; }

  .cookie-switch-note {
    font-family: inherit; font-size: 0.6875rem; text-transform: uppercase;
    letter-spacing: 0.05em; color: rgba(0,0,0,0.4); font-weight: 600;
  }

  .cookie-prefs-actions { display: flex; justify-content: flex-end; margin-top: 1rem; }
</style>

<script>
  import { readConsent, writeConsent, applyConsent } from '../lib/consent';

  const banner = document.getElementById('cookie-banner');
  const prefs = document.getElementById('cookie-prefs');
  const adsToggle = document.getElementById('cookie-cat-ads') as HTMLInputElement | null;
  const analyticsToggle = document.getElementById('cookie-cat-analytics') as HTMLInputElement | null;

  const show = () => banner?.classList.add('visible');
  const hide = () => banner?.classList.remove('visible');

  function decide(advertising: boolean, analytics: boolean) {
    const choice = { advertising, analytics };
    writeConsent(choice);
    applyConsent(choice);
    hide();
  }

  // No stored decision → ask. Consent Mode already defaults everything to
  // denied in Layout, so nothing is written while the banner waits.
  const stored = readConsent();
  if (!stored) show();

  document.getElementById('cookie-accept')?.addEventListener('click', () => decide(true, true));
  document.getElementById('cookie-reject')?.addEventListener('click', () => decide(false, false));

  document.getElementById('cookie-customise')?.addEventListener('click', () => {
    if (!prefs) return;
    prefs.hidden = !prefs.hidden;
    // Opens reflecting whatever is currently in force, not blank.
    const current = readConsent();
    if (adsToggle) adsToggle.checked = current?.advertising ?? false;
    if (analyticsToggle) analyticsToggle.checked = current?.analytics ?? false;
  });

  document.getElementById('cookie-save')?.addEventListener('click', () => {
    decide(adsToggle?.checked ?? false, analyticsToggle?.checked ?? false);
    if (prefs) prefs.hidden = true;
  });

  // Reopening after a decision. The cookie policy states the choice can be
  // withdrawn at any time, and there was no way to do it: once answered the
  // banner never returned and the value could only be changed from devtools.
  // Any element with [data-cookie-preferences] — a footer link — reopens it.
  (window as any).openCookiePreferences = () => {
    const current = readConsent();
    if (adsToggle) adsToggle.checked = current?.advertising ?? false;
    if (analyticsToggle) analyticsToggle.checked = current?.analytics ?? false;
    if (prefs) prefs.hidden = false;
    show();
  };

  document.querySelectorAll('[data-cookie-preferences]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      (window as any).openCookiePreferences();
    });
  });
</script>
