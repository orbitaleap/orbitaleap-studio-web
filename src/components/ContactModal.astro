---
import { Icon } from 'astro-icon/components';
import FormGuard from './FormGuard.astro';
---

<!-- Contact Modal Backdrop Overlay -->
<div id="contact-modal" class="fixed inset-0 z-[100] flex items-center justify-center p-4 sm:p-6 md:p-10 opacity-0 pointer-events-none transition-all duration-500 bg-black/80 backdrop-blur-2xl">
  
  <!-- Modal Card Container -->
  <div class="relative w-full max-w-2xl bg-[#161616] border border-white/15 rounded-2xl p-6 sm:p-10 text-white shadow-2xl overflow-hidden transform scale-95 transition-all duration-500 max-h-[90vh] overflow-y-auto" id="contact-modal-card">
    
    <!-- Top Corner Close Button -->
    <button type="button" id="close-modal-btn" aria-label="Cerrar formulario" class="absolute top-6 right-6 w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 border border-white/15 flex items-center justify-center text-white/70 hover:text-white transition-all cursor-pointer">
      <Icon name="ph:x-bold" class="w-5 h-5" />
    </button>

    <!-- Header Block -->
    <div class="mb-8">
      <span class="font-sans text-xs text-white/55 uppercase tracking-widest block mb-2 font-medium">HABLEMOS DE TU PROYECTO</span>
      <h2 class="font-sans text-3xl sm:text-4xl font-medium tracking-tight text-white">
        Inicia la conversación.
      </h2>
      <p class="font-sans text-white/60 font-light text-sm sm:text-base mt-2">
        Cuéntanos qué necesitas construir. Te responderemos en menos de 24 horas.
      </p>
      <a href="/test-autodiagnostico" class="font-sans text-sm text-white/50 mt-3 inline-flex items-center gap-1.5 underline underline-offset-2 hover:text-white/80 transition-colors">
        ¿No sabes qué necesitas? Haz nuestro test gratuito de 2 minutos
        <Icon name="ph:arrow-right-bold" class="w-3.5 h-3.5" />
      </a>
    </div>

    <!-- Contact Form -->
    <form id="contact-form" class="ol-form flex flex-col gap-5">

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <!-- Name -->
        <div>
          <label for="name" class="ol-label">Nombre y apellidos <span class="ol-required">*</span></label>
          <input type="text" id="name" name="name" required minlength="2" placeholder="Ej. Ana Martínez" class="ol-field" />
        </div>

        <!-- Email -->
        <div>
          <label for="email" class="ol-label">Email de contacto <span class="ol-required">*</span></label>
          <input type="email" id="email" name="email" required placeholder="ana@ejemplo.com" pattern="[^@\s]+@[^@\s]+\.[a-zA-Z]{2,}" title="Introduce un email válido, por ejemplo nombre@empresa.com" autocomplete="email" inputmode="email" class="ol-field" />
        </div>

        <!-- Company / Organization / Individual -->
        <div>
          <label for="company" class="ol-label">Empresa / Proyecto <span class="ol-optional">(opcional)</span></label>
          <input type="text" id="company" name="company" placeholder="Particular, startup o empresa" class="ol-field" />
        </div>

        <!-- Phone (Required) -->
        <div>
          <label for="phone" class="ol-label">Teléfono de contacto <span class="ol-required">*</span></label>
          <input type="tel" id="phone" name="phone" required placeholder="+34 600 000 000" pattern="[+]?[0-9][0-9\s().\-]{7,19}" title="Introduce un teléfono válido: solo números, con prefijo opcional" autocomplete="tel" inputmode="tel" class="ol-field" />
        </div>
      </div>

      <!-- Message -->
      <div>
        <div class="flex justify-between items-baseline">
          <label for="message" class="ol-label">Detalles del proyecto <span class="ol-required">*</span></label>
          <span id="char-counter" class="ol-label">Mínimo 20 caracteres</span>
        </div>
        <!-- minlength matches the counter's promise and the endpoint's floor.
             It had neither: the counter said 20, the browser accepted 1, and
             the server rejected it after a round trip. -->
        <textarea
          id="message"
          name="message"
          rows="4"
          required
          minlength="20"
          placeholder="Describe brevemente tus objetivos, alcance o plazos aproximados..."
          class="ol-field resize-none"
        ></textarea>
      </div>

      <FormGuard theme="dark" id="accept-terms" defer />

      <!-- Feedback Banner -->
      <div id="form-feedback" class="hidden p-4 rounded-lg text-sm font-sans"></div>

      <!-- Submit Button -->
      <button
        type="submit"
        id="submit-form-btn"
        class="w-full bg-white text-black font-medium py-4 px-8 rounded-lg uppercase tracking-wider text-xs transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_0_30px_rgba(255,255,255,0.3)] flex items-center justify-center gap-2 cursor-pointer mt-2"
      >
        <span id="submit-btn-content" class="inline-flex items-center gap-2">
          <span id="submit-btn-text">Enviar mensaje</span>
          <Icon name="ph:arrow-up-right-bold" class="w-4 h-4" />
        </span>
        <canvas id="submit-btn-orb" class="hidden" width="20" height="20" aria-hidden="true"></canvas>
      </button>

    </form>

  </div>
</div>

<script>
  import { mountOrb } from '../lib/thinking-orb';
  import { createLeadSubmitter } from '../lib/lead-form';

  // Turnstile script auto-loader
  if (!document.getElementById('turnstile-script')) {
    const script = document.createElement('script');
    script.id = 'turnstile-script';
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    script.async = true;
    script.defer = true;
    document.head.appendChild(script);
  }

  const modal = document.getElementById('contact-modal');
  const modalCard = document.getElementById('contact-modal-card');
  const closeBtn = document.getElementById('close-modal-btn');
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');
  const submitBtn = document.getElementById('submit-form-btn') as HTMLButtonElement;
  const submitBtnText = document.getElementById('submit-btn-text');
  const submitBtnContent = document.getElementById('submit-btn-content') as HTMLElement;
  const submitBtnOrb = document.getElementById('submit-btn-orb') as HTMLCanvasElement;
  const messageInput = document.getElementById('message') as HTMLTextAreaElement;
  const charCounter = document.getElementById('char-counter');
  let activeOrb: ReturnType<typeof mountOrb> | null = null;

  // Turnstile is rendered the first time the modal is actually shown, not at
  // page load. The widget lives inside a container that is hidden until then,
  // and starting a challenge in one makes it hang (error 300030) and retry
  // forever without ever producing a token.
  let turnstileWidgetId: string | undefined;

  function ensureTurnstile() {
    if (turnstileWidgetId !== undefined) return;
    const slot = document.querySelector('.ol-turnstile-slot') as HTMLElement | null;
    const api = (window as any).turnstile;
    // The script is loaded async; if it has not arrived yet, try again on the
    // next open rather than rendering into nothing.
    if (!slot || !api) return;

    turnstileWidgetId = api.render(slot, {
      sitekey: slot.dataset.sitekey,
      theme: slot.dataset.theme,
      action: slot.dataset.action,
      'error-callback': (window as any).olTurnstileError,
      'timeout-callback': (window as any).olTurnstileTimeout,
    });
  }

  // Open modal trigger
  window.openContactModal = () => {
    if (modal && modalCard) {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modalCard.classList.remove('scale-95');
      modalCard.classList.add('scale-100');
      document.body.style.overflow = 'hidden';
      // After the class flip, so the container has real geometry when the
      // challenge starts.
      requestAnimationFrame(ensureTurnstile);
    }
  };

  // Close modal function
  const closeModal = () => {
    if (modal && modalCard) {
      modal.classList.add('opacity-0', 'pointer-events-none');
      modalCard.classList.remove('scale-100');
      modalCard.classList.add('scale-95');
      document.body.style.overflow = '';
    }
  };

  // Has anyone actually typed anything? Losing a half-written enquiry to a
  // stray click on the backdrop is the cheapest way there is to lose a lead.
  const hasContent = () =>
    !!form && [...new FormData(form).entries()].some(
      ([k, v]) => k !== 'consent' && k !== 'cf-turnstile-response' && k !== 'website_url' && String(v).trim() !== ''
    );

  closeBtn?.addEventListener('click', closeModal);

  // The backdrop no longer closes a form that has been started. The X and
  // Escape both still work, so there is always an obvious way out — this only
  // removes the accidental one, where a click a few pixels wide of the card
  // discards everything typed with no warning and no undo.
  modal?.addEventListener('click', (e) => {
    if (e.target !== modal) return;
    if (hasContent()) {
      // Say why nothing happened, rather than appearing to be broken.
      modalCard?.animate(
        [{ transform: 'scale(1)' }, { transform: 'scale(1.01)' }, { transform: 'scale(1)' }],
        { duration: 180, easing: 'ease-out' }
      );
      return;
    }
    closeModal();
  });

  // Message char length counter
  messageInput?.addEventListener('input', () => {
    const len = messageInput.value.length;
    if (charCounter) {
      // Keeps .ol-label so the counter stays the same size and weight as the
      // labels either side of it; only the colour reacts.
      if (len < 20) {
        charCounter.textContent = `Faltan ${20 - len} caracteres`;
        charCounter.className = 'ol-label text-amber-400';
      } else {
        charCounter.textContent = `${len} caracteres`;
        charCounter.className = 'ol-label text-emerald-400';
      }
    }
  });

  // Handle Form Submission with Resend API
  // Wired once, at setup — the submitter stamps the moment the form became
  // available, which is what the endpoint's timing check measures against.
  //
  // The label names the page, not just the component. This modal is reachable
  // from every page including /launch, so a lead that arrived through paid
  // traffic would otherwise be filed as an ordinary site contact — which is
  // precisely the distinction worth having in the subject line.
  const modalSource =
    window.location.pathname.replace(/\/$/, '') === '/launch'
      ? 'studio · /launch (modal)'
      : 'studio · contacto';

  const submitLead = form ? createLeadSubmitter(form, { source: modalSource }) : null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (feedback) {
      feedback.classList.remove('hidden', 'bg-red-500/20', 'text-red-300', 'bg-emerald-500/20', 'text-emerald-300');
    }

    if (submitBtn && submitBtnContent && submitBtnOrb) {
      submitBtn.disabled = true;
      submitBtnContent.classList.add('hidden');
      submitBtnOrb.classList.remove('hidden');
      activeOrb = mountOrb(submitBtnOrb, { size: 20, color: '#0B0B0C', label: 'Enviando mensaje' });
    }

    try {
      const result = await submitLead!();
      activeOrb?.setState('resolving');

      if (!result.ok) {
        throw new Error(result.error);
      }

      form.reset();

      // On the ads landing page, redirect to the dedicated thank-you URL
      // instead of the normal inline success message — that URL is what the
      // Google Ads "Carga de la página" conversion action for /launch
      // watches for. Every other page keeps the inline-success behavior.
      if (window.location.pathname.replace(/\/$/, '') === '/launch') {
        // The one-shot flag /launch/deployed checks before firing the
        // conversion. Without it a lead submitted through the modal on
        // /launch — the same page, the same paid click — reached the
        // thank-you page and recorded nothing, because only the hero form
        // set it. Carry the click identifier across for the same reason
        // /launch does: the Ads tag does not load until that page.
        sessionStorage.setItem('ol_launch_conversion', '1');

        const src = new URLSearchParams(window.location.search);
        const carried = ['gclid', 'gbraid', 'wbraid']
          .filter((k) => src.get(k))
          .map((k) => `${k}=${encodeURIComponent(src.get(k) as string)}`)
          .join('&');
        window.location.href = '/launch/deployed' + (carried ? `?${carried}` : '');
        return;
      }

      if (feedback) {
        feedback.textContent = '¡Mensaje enviado con éxito! Nos pondremos en contacto contigo en menos de 24 horas.';
        feedback.className = 'p-4 rounded-lg text-sm font-sans bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
      }

      setTimeout(() => {
        closeModal();
        activeOrb?.destroy();
        activeOrb = null;
        if (submitBtn && submitBtnContent && submitBtnOrb && submitBtnText) {
          submitBtn.disabled = false;
          submitBtnOrb.classList.add('hidden');
          submitBtnContent.classList.remove('hidden');
          submitBtnText.textContent = 'Enviar mensaje';
        }
      }, 1200);

    } catch (err: any) {
      if (feedback) {
        feedback.textContent = err.message || 'Ocurrió un error inesperado. Por favor inténtalo de nuevo.';
        feedback.className = 'p-4 rounded-lg text-sm font-sans bg-red-500/20 text-red-300 border border-red-500/30';
      }
      setTimeout(() => {
        activeOrb?.destroy();
        activeOrb = null;
        if (submitBtn && submitBtnContent && submitBtnOrb && submitBtnText) {
          submitBtn.disabled = false;
          submitBtnOrb.classList.add('hidden');
          submitBtnContent.classList.remove('hidden');
          submitBtnText.textContent = 'Reintentar envío';
        }
      }, 700);
    }
  });

  // Attach triggers to all contact links
  document.querySelectorAll('a[href^="mailto:hello@orbitaleap.com"], a[href="#contacto"]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      window.openContactModal();
    });
  });

  // Any element opting in with [data-open-contact] opens the modal. Without this
  // every such button on /launch was an inert no-op.
  document.querySelectorAll('[data-open-contact]').forEach(el => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      window.openContactModal();
    });
  });

  // Close on Escape — the modal is a focus trap for keyboard users otherwise.
  document.addEventListener('keydown', (e) => {
    // Escape always closes, even with content: trapping keyboard users in a
    // dialog to protect a draft is a worse trade than losing the draft.
    if (e.key === 'Escape' && !modal?.classList.contains('pointer-events-none')) closeModal();
  });
</script>
