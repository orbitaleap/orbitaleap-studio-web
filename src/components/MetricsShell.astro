---
/**
 * Chrome for the internal panel: sidebar, toast, and the styles both pages
 * share. The pages themselves only render their own content.
 */
interface Props {
  title: string;
  email: string;
  /** Which sidebar entry is current. */
  active: 'dashboard' | 'usuarios';
  /** Result of the last POST, shown as a toast. */
  toast?: string | null;
}
const { title, email, active, toast } = Astro.props;

const nav = [
  { href: '/metrics', label: 'Panel', key: 'dashboard' },
  { href: '/metrics/usuarios', label: 'Usuarios', key: 'usuarios' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} · Orbital Leap Studio</title>
    <style>
      :root {
        --bg: #0d0d0d; --panel: #141414; --line: rgba(255,255,255,0.10);
        --ink: #ffffff; --mid: rgba(255,255,255,0.62); --dim: rgba(255,255,255,0.42);
        --bar: rgba(255,255,255,0.85);
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
        font-size: 15px; line-height: 1.5;
      }

      /* Sidebar becomes a top bar below 860px rather than a drawer: two links
         do not justify a hamburger, and a row of two reads fine on a phone. */
      .layout { display: grid; grid-template-columns: 220px minmax(0, 1fr); min-height: 100vh; }
      .side {
        border-right: 1px solid var(--line); padding: 26px 18px;
        display: flex; flex-direction: column; gap: 26px; position: sticky; top: 0; height: 100vh;
      }
      .brand { font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--dim); }
      .nav { display: flex; flex-direction: column; gap: 2px; }
      .nav a {
        display: block; padding: 9px 12px; border-radius: 8px; text-decoration: none;
        color: var(--mid); font-size: 0.9rem; transition: background 0.15s, color 0.15s;
      }
      .nav a:hover { background: rgba(255,255,255,0.04); color: var(--ink); }
      .nav a[aria-current="page"] { background: rgba(255,255,255,0.08); color: var(--ink); font-weight: 500; }
      .side-foot { margin-top: auto; display: flex; flex-direction: column; gap: 10px; }
      .who { font-size: 0.75rem; color: var(--dim); word-break: break-all; }
      .out {
        background: none; border: 1px solid var(--line); color: var(--dim); border-radius: 8px;
        padding: 7px 10px; font-size: 0.75rem; cursor: pointer; width: 100%;
      }
      .out:hover { border-color: rgba(255,255,255,0.4); color: var(--ink); }
      main { padding: clamp(24px, 4vw, 44px) clamp(16px, 3vw, 40px) 80px; max-width: 1180px; }
      h1 { font-size: clamp(1.5rem, 3.5vw, 2rem); font-weight: 700; letter-spacing: -0.02em; margin: 0 0 6px; }
      .lede { color: var(--mid); font-size: 0.9rem; margin: 0 0 32px; max-width: 64ch; }

      @media (max-width: 860px) {
        .layout { grid-template-columns: 1fr; }
        .side {
          position: static; height: auto; flex-direction: row; align-items: center;
          border-right: 0; border-bottom: 1px solid var(--line); padding: 14px 16px; gap: 16px;
        }
        .brand { display: none; }
        .nav { flex-direction: row; gap: 4px; }
        .side-foot { margin-top: 0; margin-left: auto; flex-direction: row; align-items: center; gap: 10px; }
        .who { display: none; }
        .out { width: auto; }
      }

      /* Shared building blocks */
      .card { border: 1px solid var(--line); background: var(--panel); border-radius: 12px; padding: 20px; }
      .card h2 { font-size: 0.72rem; letter-spacing: 0.13em; text-transform: uppercase; color: var(--dim); margin: 0 0 16px; font-weight: 500; }
      .tablewrap { border: 1px solid var(--line); background: var(--panel); border-radius: 12px; overflow-x: auto; }
      table { border-collapse: collapse; width: 100%; font-size: 0.86rem; }
      th { text-align: left; font-size: 0.68rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--dim); font-weight: 500; padding: 14px; border-bottom: 1px solid var(--line); white-space: nowrap; }
      td { padding: 13px 14px; border-bottom: 1px solid rgba(255,255,255,0.06); vertical-align: top; color: var(--mid); }
      tr:last-child td { border-bottom: 0; }
      td.who-cell { color: var(--ink); font-weight: 500; }
      td.when { white-space: nowrap; font-variant-numeric: tabular-nums; }
      .chip { display: inline-block; padding: 3px 9px; border: 1px solid var(--line); border-radius: 999px; font-size: 0.72rem; color: var(--ink); white-space: nowrap; }
      .empty { padding: 40px 20px; text-align: center; color: var(--dim); }
      .btn { border: 1px solid var(--line); background: none; color: var(--mid); border-radius: 7px; padding: 6px 11px; font-size: 0.75rem; cursor: pointer; }
      .btn:hover { border-color: rgba(255,255,255,0.4); color: var(--ink); }
      .btn.danger:hover { border-color: rgba(255,120,120,0.6); color: #ff8080; }
      .btn.primary { background: #fff; color: #000; border-color: #fff; font-weight: 600; padding: 9px 16px; font-size: 0.82rem; }
      .note { border: 1px solid var(--line); background: var(--panel); border-radius: 10px; padding: 14px 16px; margin-bottom: 24px; color: var(--mid); font-size: 0.88rem; }
      .note.warn { border-color: rgba(255,180,80,0.45); }
      .note code { background: rgba(255,255,255,0.07); padding: 2px 6px; border-radius: 4px; font-size: 0.85em; }
      a { color: inherit; }

      /* Toast. Server-rendered, then dismissed on a timer — the result of a
         POST is known at render time, so announcing it needs no round trip. */
      .toast {
        position: fixed; right: 20px; bottom: 20px; z-index: 50; max-width: min(380px, calc(100vw - 40px));
        border: 1px solid var(--line); background: #1b1b1b; border-radius: 10px;
        padding: 13px 16px; font-size: 0.86rem; color: var(--ink);
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        display: flex; gap: 12px; align-items: flex-start;
        animation: toast-in 0.22s cubic-bezier(0.22, 1, 0.36, 1);
      }
      .toast[hidden] { display: none; }
      .toast button { background: none; border: 0; color: var(--dim); cursor: pointer; font-size: 1rem; line-height: 1; padding: 0; }
      .toast button:hover { color: var(--ink); }
      @keyframes toast-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
      @media (prefers-reduced-motion: reduce) { .toast { animation: none; } }

      /* Dialogs, native. ::backdrop needs no overlay div and Escape closes
         them without a keydown listener. */
      dialog {
        border: 1px solid var(--line); background: var(--panel); color: var(--ink);
        border-radius: 14px; padding: 28px; width: min(430px, 92vw);
      }
      dialog::backdrop { background: rgba(0,0,0,0.6); }
      dialog h2 { font-size: 1.05rem; text-transform: none; letter-spacing: -0.01em; color: var(--ink); margin: 0 0 6px; font-weight: 600; }
      dialog p.sub { margin: 0 0 20px; color: var(--dim); font-size: 0.85rem; }
      dialog label { display: block; font-size: 0.75rem; color: var(--dim); margin-bottom: 12px; }
      dialog input {
        display: block; width: 100%; margin-top: 5px; padding: 10px 12px; border-radius: 8px;
        border: 1px solid var(--line); background: rgba(255,255,255,0.04); color: var(--ink); font-size: 0.92rem;
      }
      dialog input:focus { outline: 1px solid rgba(255,255,255,0.45); outline-offset: 1px; }
      .dialog-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 22px; }
    </style>
  </head>
  <body>
    <div class="layout">
      <aside class="side">
        <div class="brand">Orbital Leap</div>
        <nav class="nav">
          {nav.map((n) => (
            <a href={n.href} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <div class="side-foot">
          <span class="who">{email}</span>
          <button class="out" id="logout" type="button">Cerrar sesión</button>
        </div>
      </aside>

      <main>
        <slot />
      </main>
    </div>

    {toast && (
      <div class="toast" id="toast" role="status" aria-live="polite">
        <span>{toast}</span>
        <button type="button" aria-label="Cerrar" onclick="this.parentElement.hidden = true">×</button>
      </div>
    )}

    <script>
      // Logout is client-side because the cookie is not HttpOnly — it is
      // written by script after the token exchange, so script has to clear it.
      document.getElementById('logout')?.addEventListener('click', () => {
        document.cookie = 'ol_metrics_jwt=; Path=/metrics; Max-Age=0; Secure; SameSite=Strict';
        location.href = '/metrics';
      });

      // Drop the toast after a while, and take its query param with it so a
      // refresh does not replay a message about something that already
      // happened.
      const t = document.getElementById('toast');
      if (t) {
        setTimeout(() => { t.hidden = true; }, 5200);
        if (location.search) {
          history.replaceState(null, '', location.pathname);
        }
      }
    </script>
  </body>
</html>
