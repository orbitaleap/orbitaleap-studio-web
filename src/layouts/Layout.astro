---
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/global.css';
import ScrollProgress from '../components/ScrollProgress.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  noindex?: boolean;
  /** Load the Google Ads tag. Only the page the ads point at should. */
  ads?: boolean;
}

const {
  title,
  description = "Orbital Leap - Estudio de diseño y desarrollo digital. Creamos páginas web, plataformas y aplicaciones a medida.",
  lang = "es",
  noindex = false,
  ads = false
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://studio.orbitaleap.com");
// Raster, 1200x630. This used to point at the logo SVG, which every social
// platform (LinkedIn, WhatsApp, X, Slack, iMessage) ignores — shared links
// rendered with no image at all.
const ogImage = new URL("/og-card.png", canonicalURL);

const googleFontsHref = "https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=Product+Sans:wght@400;500;700&family=Roboto+Mono:wght@300;400;500&display=swap";

// Google Ads conversion tracking — the /launch landing page and its
// thank-you URL (/launch/deployed) depend on this base tag being present
// sitewide (Google Ads' "Carga de la página" conversion action matches
// page_view events emitted by this same tag). Unset until an ID is provided,
// so nothing renders until then.
// Literal fallback, like the Turnstile site key beside it. A Google Ads
// conversion ID is public — it ships in the page for anyone to read — so
// there is nothing to protect by keeping it out of the repo, and plenty to
// lose: PUBLIC_* is inlined at BUILD time, the value was set as a Cloudflare
// RUNTIME secret, and a runtime secret can never reach a build. That mismatch
// is why the tag was absent from the live site while the dashboard showed it
// configured. The env var still wins where it is genuinely provided.
const googleAdsId = import.meta.env.PUBLIC_GOOGLE_ADS_ID || 'AW-18312929105';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111111" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicon & Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- OpenGraph / Social Metadata -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Orbital Leap — Diseño y desarrollo digital a medida" />
    <meta property="og:site_name" content="Orbital Leap" />
    <meta property="og:locale" content="es_ES" />

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts — loaded off the critical path. As a plain stylesheet this
         request blocked first paint by ~850ms; media="print" lets the browser
         fetch it at low priority and the onload flip applies it as soon as it
         lands. font-display:swap in the sheet means text is readable meanwhile. -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href={googleFontsHref}>
    <link rel="stylesheet" href={googleFontsHref} media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href={googleFontsHref}></noscript>

    <!--
      Google Ads tag. Two conditions, not one.

      `ads` — this was in the shared layout, so it loaded on every page of the
      site. The campaign points at /launch and that is the only page that needs
      conversion tracking; loading a third-party advertising tag on the privacy
      policy is both unnecessary and a harder thing to justify in it.

      Consent Mode v2, defaulting to GRANTED, and an explicit rejection is
      still honoured — CookieBanner flips every storage type to denied the
      moment someone declines, and a previous rejection is re-applied on load.

      This is a deliberate business decision, recorded here because the
      default cuts against the usual reading of the ePrivacy directive: for
      EEA visitors advertising cookies are supposed to be set only AFTER
      consent, and granting by default means the tag writes before anyone has
      answered. Denied-by-default was the compliant arrangement and cost
      measurement on traffic that never touches the banner, which is why it
      was rejected. If that trade is ever revisited, the single word to change
      is on the four lines below.
    -->
    {ads && googleAdsId && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${googleAdsId}`}></script>
        <script define:vars={{ googleAdsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){ dataLayer.push(arguments); }
          window.gtag = gtag;

          gtag('consent', 'default', {
            ad_storage: 'granted',
            ad_user_data: 'granted',
            ad_personalization: 'granted',
            analytics_storage: 'granted'
          });

          gtag('js', new Date());
          gtag('config', googleAdsId);

          // A visitor who declined on a previous visit stays declined. This is
          // the half that has to survive a reload now that the default grants:
          // without it, rejecting would last exactly one page view.
          if (localStorage.getItem('ol_cookie_consent') === 'rejected') {
            gtag('consent', 'update', {
              ad_storage: 'denied',
              ad_user_data: 'denied',
              ad_personalization: 'denied',
              analytics_storage: 'denied'
            });
          }
        </script>
      </>
    )}
  </head>
  <body class="bg-brand-bg text-brand-light min-h-screen flex flex-col relative selection:bg-white selection:text-black">
    <ScrollProgress />
    
    <div class="fixed top-0 inset-x-0 h-20 pointer-events-none z-40 backdrop-blur-md [mask-image:linear-gradient(to_bottom,black_0%,transparent_100%)]"></div>

    <slot />

    <script>
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);
    </script>
    <!--
      The cookie notice. This component has existed in the repo for weeks and
      was imported by nothing, so it rendered on no page — the site asked for
      consent only in the sense that the code to ask existed.
    -->
    <CookieBanner />
  </body>
</html>
