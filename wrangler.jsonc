{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-28",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "orbitaleap-studio-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},

	// Leads, kept by us rather than only in an inbox. Powers /metrics.
	//
	// COMMENTED OUT UNTIL THE DATABASE EXISTS, and that is not tidiness — it
	// is the only safe state. An empty database_id fails the build outright
	// ("AssertionError: '' == true"), and a placeholder id builds but then
	// fails `wrangler deploy`, which validates that the database is real.
	// Either way the whole site stops deploying, not just the dashboard.
	//
	// To switch it on:
	//
	//   npx wrangler d1 create orbitaleap-leads
	//   # paste the printed id below, uncomment this block, then:
	//   npx wrangler d1 migrations apply orbitaleap-leads --remote
	//
	// Until then nothing is broken. send-email.ts reads the binding through
	// readBinding(), which returns undefined, and recordLead() treats that as
	// a normal state — leads are still delivered, they are just not counted.
	// /metrics says so in as many words rather than erroring.
	//
	// "d1_databases": [
	// 	{
	// 		"binding": "DB",
	// 		"database_name": "orbitaleap-leads",
	// 		"database_id": "PASTE-THE-ID-FROM-d1-create-HERE",
	// 		"migrations_dir": "migrations"
	// 	}
	// ]
}